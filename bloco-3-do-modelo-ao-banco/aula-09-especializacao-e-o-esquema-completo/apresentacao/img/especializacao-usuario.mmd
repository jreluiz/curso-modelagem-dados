---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
  flowchart:
    nodeSpacing: 22
    rankSpacing: 45
    padding: 14
    wrappingWidth: 400
---
flowchart LR
    USUARIO[USUARIO] === D(("d"))
    D --- ALUNO[ALUNO]
    D --- PROF[PROFESSOR]
    ALUNO --- mat((matricula))
    PROF --- siape((siape))
    PROF ---|1| PROP{PROPOE}
    PROP ---|N| OFI[OFICINA]
    cod(("<u>codigo</u>")) --- USUARIO
    class D cir
    classDef leg fill:none,stroke:none,color:#336791
    classDef erro fill:#fbeaea,stroke:#a33,stroke-width:3px,color:#1a1a1a
    classDef ok fill:#eaf5ea,stroke:#2a7,stroke-width:3px,color:#1a1a1a
    classDef sch fill:#fdfdfb,stroke:#336791,stroke-width:2px,color:#1a1a1a
    classDef cir fill:#ffffff,stroke:#336791,stroke-width:2px,color:#336791
    linkStyle default stroke:#336791,stroke-width:3px
