    wrappingWidth: 400
---
flowchart TB
    A["<b>LIVRO</b>(<u>isbn</u>, titulo, cnpj, editora)<br/>isbn → cnpj → editora"]
    A -->|"depende do cnpj"| B["<b>EDITORA</b>(<u>cnpj</u>, nome)"]
    A -->|"depende do isbn"| C["<b>LIVRO</b>(<u>isbn</u>, titulo, cnpj → EDITORA)"]
    class A erro
    class B ok
    class C sch
    classDef leg fill:none,stroke:none,color:#336791
    classDef erro fill:#fbeaea,stroke:#a33,stroke-width:3px,color:#1a1a1a
    classDef ok fill:#eaf5ea,stroke:#2a7,stroke-width:3px,color:#1a1a1a
    classDef sch fill:#fdfdfb,stroke:#336791,stroke-width:2px,color:#1a1a1a
    classDef cir fill:#ffffff,stroke:#336791,stroke-width:2px,color:#336791
    linkStyle default stroke:#336791,stroke-width:3px
