---
flowchart LR
    R["<b>RETIRADA</b>(<u>isbn, numero_ex,</u><br/><u>data_retirada</u>, codigo_usuario)"] -->|"isbn"| L["<b>LIVRO</b>(<u>isbn</u>,<br/>titulo, cnpj)"]
    L -->|"cnpj"| E["<b>EDITORA</b><br/>(<u>cnpj</u>, nome)"]
    R -->|"codigo_usuario"| U["<b>USUARIO</b><br/>(<u>codigo</u>, nome)"]
    A["<b>LIVRO_AUTOR</b><br/>(<u>isbn, autor</u>)"] -->|"isbn"| L
    class R,L,E,U,A ok
    classDef leg fill:none,stroke:none,color:#336791
    classDef erro fill:#fbeaea,stroke:#a33,stroke-width:3px,color:#1a1a1a
    classDef ok fill:#eaf5ea,stroke:#2a7,stroke-width:3px,color:#1a1a1a
    classDef sch fill:#fdfdfb,stroke:#336791,stroke-width:2px,color:#1a1a1a
