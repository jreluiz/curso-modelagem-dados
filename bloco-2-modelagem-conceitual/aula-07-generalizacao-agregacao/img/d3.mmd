---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
    edgeLabelBackground: "#fdfdfb"
---
flowchart TD
    subgraph AGG["a agregação — tudo isto é tratado como uma entidade única"]
        PROFESSOR[PROFESSOR] --- ORIENTA{ORIENTA} --- ALUNO[ALUNO]
    end
    AGG --- RECEBE{RECEBE} --- BOLSA[BOLSA]
