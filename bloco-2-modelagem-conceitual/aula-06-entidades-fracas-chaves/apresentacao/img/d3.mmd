---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
    edgeLabelBackground: "#fdfdfb"
---
erDiagram
    USUARIO ||--o{ TELEFONE : "tem"
    USUARIO {
        int matricula PK
        varchar nome
    }
    TELEFONE {
        int matricula PK "FK do usuário"
        varchar numero PK "chave parcial"
        varchar tipo "celular, residencial, recado"
        boolean principal
    }
