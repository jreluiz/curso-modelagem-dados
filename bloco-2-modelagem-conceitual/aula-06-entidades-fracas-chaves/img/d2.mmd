---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
    edgeLabelBackground: "#fdfdfb"
---
erDiagram
    FUNCIONARIO ||--o{ DEPENDENTE : "possui"
    DEPENDENTE {
        int matricula PK "FK herdada do funcionário"
        varchar nome PK "chave parcial"
        date data_nascimento
        varchar parentesco
    }
