---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
    edgeLabelBackground: "#fdfdfb"
---
flowchart TD
    DT[DIM_TEMPO] --- FATO
    DU[DIM_USUARIO] --- FATO
    FATO["<b>FATO_EMPRESTIMO</b><br><i>medidas: quantidade, dias_atraso</i>"]
    FATO --- DO[DIM_OBRA]
    FATO --- DUN[DIM_UNIDADE]
