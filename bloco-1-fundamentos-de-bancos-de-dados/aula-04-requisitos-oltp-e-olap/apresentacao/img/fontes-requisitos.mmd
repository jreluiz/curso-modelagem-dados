---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
  flowchart:
    nodeSpacing: 28
    rankSpacing: 60
    padding: 14
    wrappingWidth: 400
---
flowchart LR
    E["Entrevista"]
    D["Documento"]
    L["Sistema legado"]
    O["Observação"]
    R["A LISTA DE<br/>REQUISITOS<br/>RN-01, RN-02…"]
    M["O MODELO<br/>do Bloco 2"]

    E --> R
    D --> R
    L --> R
    O --> R
    R --> M

    classDef fonte fill:#eaf0f5,stroke:#336791,stroke-width:3px,color:#1a1a1a
    classDef lista fill:#336791,stroke:#336791,stroke-width:3px,color:#ffffff
    classDef fim fill:#fdfdfb,stroke:#336791,stroke-width:2px,color:#1a1a1a
    class E,D,L,O fonte
    class R lista
    class M fim
    linkStyle default stroke:#336791,stroke-width:3px
