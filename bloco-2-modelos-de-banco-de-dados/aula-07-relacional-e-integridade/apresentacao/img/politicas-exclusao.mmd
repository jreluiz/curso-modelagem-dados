---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#336791"
    primaryColor: "#eaf0f5"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#336791"
  flowchart:
    nodeSpacing: 24
    rankSpacing: 55
    padding: 14
    wrappingWidth: 400
---
flowchart TD
    Q["<b>A entidade do outro lado<br/>existe sem esta?</b>"]
    Q -->|"não · participação total"| P["<b>PROPAGAR</b><br/>apaga junto"]
    Q -->|"sim · e a ligação importa"| R["<b>RECUSAR</b><br/>não deixa apagar"]
    Q -->|"sim · e a ligação é opcional"| A["<b>ANULAR</b><br/>deixa a coluna vazia"]
    class Q ent
    class P,R,A sch
    classDef ent fill:#eaf0f5,stroke:#336791,stroke-width:3px,color:#1a1a1a
    classDef sch fill:#fdfdfb,stroke:#336791,stroke-width:2px,color:#1a1a1a
    classDef ok fill:#eaf5ea,stroke:#2a7,stroke-width:2px,color:#1a1a1a
    classDef bad fill:#fbeaea,stroke:#a33,stroke-width:2px,color:#a33
    linkStyle default stroke:#336791,stroke-width:3px
